# 本地开发（默认 mode，不传 --mode）
# npm run dev
# Vite 会在所有 mode 下先加载本文件，再由 .env.dev / .env.pro 覆盖同名变量。

VITE_APP_ENV=local
VITE_APP_TITLE=观影jun.sun
VITE_BASE=/
VITE_SOURCEMAP=true
VITE_DEV_PORT=5174

# false：图片和播放直连片源。true：图片和播放也走本站代理。片库页始终走 /api-video-pomelo7-server/vod
VITE_USE_PROXY=false

# 片源地址。直连时浏览器访问这些地址；走代理时只给开发代理使用
VITE_VOD_TARGET=https://www.dushe05.com
VITE_IMG_TARGET=https://vres.wkcyvs.cn
VITE_IMG_A_TARGET=https://103.39.111.180:51050
VITE_IMG_B_TARGET=https://103.39.111.184:51050
